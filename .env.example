# Secret-only local bridge for Hermes smoke and owner template inventories.
# Keep ordinary non-secret config in TOML under profiles/.
# Production/operator runs should prefer Phase injection, for example:
#   phase run --app exo-executive-agent --env dev --path /tom/local -- <command>
# If a local dotenv-compatible bridge is needed, use Node's built-in dotenv
# support or the consuming tool's native env support. Do not add dotenv by
# default, and do not use VITE_ prefixes for secrets.

# Phase app: exo-executive-agent
# Phase environment: dev
# Phase path: /tom/local
# Runtime reason: consumed by the Telegram gateway provider.
TELEGRAM_BOT_TOKEN=

# Phase app: exo-executive-agent
# Phase environment: dev
# Phase path: /tom/local
# Runtime reason: owner-only Telegram authorization at gateway startup.
TELEGRAM_OWNER_ID=

# Phase app: exo-executive-agent
# Phase environment: dev
# Phase path: /tom/local
# Runtime reason: consumed by the selected model provider when live mode is enabled.
OPENAI_API_KEY=

# Phase app: exo-executive-agent
# Phase environment: prod
# Phase path: /tom/personal-agent
# Runtime reason: Tom personal Telegram gateway token.
TOM_TELEGRAM_BOT_TOKEN=
TOM_TELEGRAM_OWNER_ID=
TOM_OPENAI_API_KEY=

# Phase app: exo-executive-agent
# Phase environment: prod
# Phase path: /sebastian/personal-agent
# Runtime reason: Sebastian personal Telegram gateway token.
SEBASTIAN_TELEGRAM_BOT_TOKEN=
SEBASTIAN_TELEGRAM_OWNER_ID=
SEBASTIAN_OPENAI_API_KEY=

# Phase app: exo-executive-agent
# Phase environment: prod
# Phase path: /noah/personal-agent
# Runtime reason: Noah personal Telegram gateway token.
NOAH_TELEGRAM_BOT_TOKEN=
NOAH_TELEGRAM_OWNER_ID=
NOAH_OPENAI_API_KEY=
